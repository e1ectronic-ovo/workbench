<Window x:Class="Whaletide.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:native="clr-namespace:Whaletide.Desktop.Native"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="鲸汐"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource ShellBg}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ChromeBg}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource Accent}" Margin="0,0,9,0">
                        <TextBlock Text="鲸" Foreground="#041A17" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="鲸汐" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="WPF 原生嵌入" Foreground="{StaticResource TextMuted}" FontSize="11"
                               Margin="8,1,0,0" VerticalAlignment="Center" />
                    <Border Background="#141B24" BorderBrush="#243040" BorderThickness="1"
                            CornerRadius="5" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TargetStateDot" Width="6" Height="6" Fill="#64748B"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="TargetStateText" Text="未嵌入" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="PickWindowButton" Content="选择窗口" Style="{StaticResource PanelButton}"
                            Height="28" Margin="12,0,7,0" Padding="12,0" Click="PickWindow_Click" />
                    <Button x:Name="DetachButton" Content="解除嵌入" Style="{StaticResource PanelButton}"
                            Height="28" Margin="0" Padding="12,0" Click="DetachButton_Click" IsEnabled="False" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource ChromeButton}" Click="MaximizeButton_Click" />
                    <Button Content="×" Style="{StaticResource ChromeButton}" Click="CloseButton_Click"
                            Foreground="#C7D0DD" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentRoot" Grid.Row="1" Background="{StaticResource ShellBg}">
            <wv2:WebView2 x:Name="Browser" />

            <!-- WebView2 与 HwndHost 存在 airspace：原生窗口必须放在独立 HWND 覆盖层。 -->
            <Canvas x:Name="NativeOverlay" Panel.ZIndex="10" ClipToBounds="True" Visibility="Collapsed">
                <native:NativeWindowHost x:Name="WindowHost"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Width="1"
                                         Height="1" />
            </Canvas>

            <Border x:Name="StartupMask" Background="{StaticResource ShellBg}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Accent}" Opacity="0.9">
                        <TextBlock Text="鲸" Foreground="#041A17" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="StartupText" Text="正在启动 WebView2…" Foreground="{StaticResource TextMuted}"
                               FontSize="12" Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
