{
  "name": "workbench",
  "version": "0.2.0",
  "description": "Personal workbench - desktop client with home dashboard and site modules",
  "private": true,
  "main": "out/main/index.js",
  "author": "Workbench",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "node scripts/fetch-core.mjs && npm run build && electron-builder --dir",
    "dist": "node scripts/fetch-core.mjs && npm run build && electron-builder --win",
    "core": "node scripts/fetch-core.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "whale-assets": "node scripts/optimize-whale-assets.mjs",
    "maid-assets": "node scripts/fetch-maid-atelier-assets.mjs",
    "release": "npm run dist -- --publish always"
  },
  "build": {
    "appId": "com.workbench.app",
    "productName": "Workbench",
    "copyright": "Copyright © 2026 Workbench",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "icon.svg",
          "icon.png",
          "icon.ico"
        ]
      },
      {
        "from": "resources/core",
        "to": "core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workbench",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "e1ectronic-ovo",
      "repo": "workbench"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "pinia": "^2.2.6",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.3.3",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.12.0",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  }
}
